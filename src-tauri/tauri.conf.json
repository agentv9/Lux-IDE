{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lux",
  "version": "0.1.0",
  "identifier": "com.kaseknife95.lux",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "decorations": false,
        "title": "lux",
        "shadow": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources": {
      "../node_modules/typescript/lib/": "typescript/",
      "../node_modules/typescript/package.json": "typescript/package.json"
    },
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
     "windows": {
      "wix": {
        "fragmentPaths": ["./windows/fragments/context_menu.wxs"],
        "componentRefs": ["AppContextMenuEntries"]
      }
    }
  }
}
